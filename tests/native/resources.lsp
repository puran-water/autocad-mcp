;;; Run only in a disposable drawing, after loading revision_tools.lsp.
;;; No customer files or fonts are required. Returns JSON through pcad:run.
(defun pcad-test:check (condition label)
  (pcad:require condition (strcat "REGRESSION: " label))
  (setq pcad-test:passed (cons label pcad-test:passed)))
(defun pcad-test:resources (/ before after result font tab dbmod bg report)
  (setq pcad-test:passed nil)
  (pcad:require (not (tblsearch "LAYER" "MCP-RESOURCE-TEST")) "USE_FRESH_DISPOSABLE_DRAWING")
  (mcp-cmd-layer-create "{\"name\":\"MCP-RESOURCE-TEST\",\"color\":\"red\"}")
  (setq before (entget (tblobjname "LAYER" "MCP-RESOURCE-TEST")))
  (pcad-test:check (= (cdr (assoc 62 before)) 1) "new layer honors explicit color")
  ;; Include off/locked/nonplotting/lineweight properties in the no-op check.
  (setq before (subst (cons 62 -1) (assoc 62 before) before))
  (setq before (subst (cons 70 4) (assoc 70 before) before))
  (setq before (subst (cons 290 0) (assoc 290 before) before))
  (setq before (subst (cons 370 35) (assoc 370 before) before))
  (entmod before)
  (setq before (entget (tblobjname "LAYER" "MCP-RESOURCE-TEST")))
  (setq result (mcp-cmd-layer-create "{\"name\":\"MCP-RESOURCE-TEST\"}"))
  (setq after (entget (tblobjname "LAYER" "MCP-RESOURCE-TEST")))
  (pcad-test:check (equal before after) "default create preserves entire existing layer")
  (pcad-test:check (vl-string-search "\"existed\":true" (cdr result)) "existing layer receipt")
  (mcp-cmd-layer-create "{\"name\":\"MCP-RESOURCE-TEST\",\"color\":\"blue\",\"linetype\":\"CONTINUOUS\"}")
  (pcad-test:check (equal before (entget (tblobjname "LAYER" "MCP-RESOURCE-TEST")))
    "explicit create arguments do not restyle existing layer")
  (mcp-layer-apply "MCP-RESOURCE-TEST" "blue" nil nil)
  (pcad-test:check (= (abs (cdr (assoc 62 (tblsearch "LAYER" "MCP-RESOURCE-TEST")))) 5)
    "explicit property update remains available")
  (setq font (findfile "simplex.shx"))
  (pcad:require font "TEST_REQUIRES_STANDARD_SIMPLEX_SHX")
  (pcad-test:check (equal font (pcad:resolve-font "simplex")) "extensionless SHX resolves to path")
  (setq font (findfile (strcat (getenv "WINDIR") "/Fonts/arial.ttf")))
  (pcad:require font "TEST_REQUIRES_STANDARD_WINDOWS_ARIAL")
  (pcad-test:check (equal (strcase font) (strcase (pcad:resolve-font "arial.ttf")))
    "installed Windows TrueType font resolves to path")
  (pcad-test:check (null (pcad:resolve-font "mcp-no-such-font-789.shx")) "missing font remains unresolved")
  (pcad-test:check (null (pcad:resolve-font "")) "empty bigfont has no resolution")
  (pcad-test:check (= "not_specified" (pcad:font-status "" nil)) "empty bigfont is not missing")
  (pcad-test:check (= "available" (pcad:plot-style-status "MONOCHROME.CTB" T '("monochrome.ctb") T))
    "plot catalog match is case insensitive")
  (pcad-test:check (= "missing" (pcad:plot-style-status "absent.ctb" T '("monochrome.ctb") T))
    "absent required style is missing")
  (pcad-test:check (= "missing" (pcad:plot-style-status "absent.ctb" T nil T))
    "empty verified catalog is not unknown")
  (pcad-test:check (= "unverified" (pcad:plot-style-status "absent.ctb" T nil nil))
    "unavailable catalog does not assert missing")
  (pcad-test:check (= "not_required" (pcad:plot-style-status "absent.ctb" nil nil nil))
    "disabled plot styles do not block")
  (pcad-test:check (= "not_required" (pcad:plot-style-status "" T nil nil))
    "unassigned plot style does not block")
  (setq tab (getvar "CTAB") dbmod (getvar "DBMOD") bg (getvar "BACKGROUNDPLOT"))
  (setq report (pcad:resource-preflight (pcad:fullpath)))
  (pcad-test:check (and (= tab (getvar "CTAB")) (= dbmod (getvar "DBMOD"))
    (= bg (getvar "BACKGROUNDPLOT"))) "preflight preserves document state")
  (pcad-test:check (eq (cdr (assoc "rendering_verified" (cadr report))) 'pcad-false)
    "resource preflight does not claim rendering qualification")
  (pcad:obj (list (cons "passed" (pcad:arr (reverse pcad-test:passed)))
    (cons "count" (length pcad-test:passed)))))
(princ)

(defun pcad-test:plot-resources (path / doc lo e d oldstyle tab bg reply media)
  (setq pcad-test:passed nil doc (vla-get-ActiveDocument (vlax-get-acad-object))
        lo (vla-Item (vla-get-Layouts doc) "Model")
        tab (getvar "CTAB") bg (getvar "BACKGROUNDPLOT"))
  (pcad:require (not (findfile path)) "TEST_OUTPUT_MUST_BE_NEW")
  (vla-put-ConfigName lo "DWG To PDF.pc3")
  (vla-RefreshPlotDeviceInfo lo)
  (setq media (vlax-safearray->list (vlax-variant-value (vla-GetCanonicalMediaNames lo))))
  (vla-put-CanonicalMediaName lo (car media))
  (vla-put-PlotType lo 1) (vla-put-UseStandardScale lo :vlax-true)
  (vla-put-StandardScale lo 0) (vla-put-CenterPlot lo :vlax-true)
  (vla-put-PlotWithPlotStyles lo :vlax-true)
  (vla-AddLine (vla-get-ModelSpace doc) (vlax-3d-point '(10 10 0)) (vlax-3d-point '(110 10 0)))
  (vla-AddText (vla-get-ModelSpace doc) "RESOURCE TEST ONLY" (vlax-3d-point '(10 15 0)) 4.0)
  ;; StyleSheet's setter validates resources. DXF simulates a drawing received
  ;; with a missing CTB without removing or changing any installed resource.
  (setq e (vlax-vla-object->ename lo) d (entget e))
  (pcad:require (assoc 7 d) "STYLE_DXF_REQUIRED")
  (pcad:require (entmod (subst (cons 7 "mcp-no-such-style-789.ctb") (assoc 7 d) d))
    "SET_TEST_STYLE_FAILED")
  (setq reply (pcad:run 'pcad:plot (list (pcad:fullpath) "Model" path)))
  (pcad-test:check (vl-string-search "PLOT_STYLE_MISSING" reply) "missing CTB prevents plot")
  (pcad-test:check (not (findfile path)) "failed preflight creates no PDF")
  (pcad-test:check (and (= tab (getvar "CTAB")) (= bg (getvar "BACKGROUNDPLOT")))
    "failed plot restores active layout and background setting")
  (vla-put-StyleSheet lo "monochrome.ctb")
  (setq reply (pcad:run 'pcad:plot (list (pcad:fullpath) "Model" path)))
  (pcad-test:check (and (findfile path) (> (vl-file-size path) 0)) "available CTB produces PDF")
  (pcad-test:check (vl-string-search "\"style_status\":\"available\"" reply) "plot receipt retains resource status")
  (pcad-test:check (vl-string-search "\"rendering_verified\":false" reply) "plot does not overclaim fidelity")
  (pcad-test:check (and (= tab (getvar "CTAB")) (= bg (getvar "BACKGROUNDPLOT")))
    "successful plot restores active layout and background setting")
  (setq reply (pcad:run 'pcad:plot (list (pcad:fullpath) "Model" path)))
  (pcad-test:check (vl-string-search "PLOT_OUTPUT_EXISTS" reply) "existing PDF is not overwritten")
  (pcad:obj (list (cons "passed" (pcad:arr (reverse pcad-test:passed)))
    (cons "count" (length pcad-test:passed)))))
